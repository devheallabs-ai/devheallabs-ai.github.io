{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devheallabs.com/dh-adom/source/02-Specification/Schema-Definitions/audit-event.schema.json",
  "title": "DH-ADOM Audit Event",
  "type": "object",
  "required": [
    "event_id",
    "timestamp",
    "actor",
    "action",
    "resource",
    "result"
  ],
  "properties": {
    "event_id": {
      "type": "string"
    },
    "timestamp": {
      "type": "string"
    },
    "actor": {
      "type": "string"
    },
    "action": {
      "type": "string"
    },
    "resource": {
      "type": "string"
    },
    "parent_agent": {
      "type": [
        "string",
        "null"
      ]
    },
    "delegation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "result": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "details": {
      "type": "object"
    }
  }
}