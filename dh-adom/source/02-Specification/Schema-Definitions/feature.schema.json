{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://devheallabs.com/dh-adom/source/02-Specification/Schema-Definitions/feature.schema.json",
  "title": "DH-ADOM Feature",
  "type": "object",
  "required": [
    "feature_id",
    "name",
    "owner_agent",
    "intent",
    "scope"
  ],
  "properties": {
    "feature_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "owner_agent": {
      "type": "string"
    },
    "parent_agent": {
      "type": "string"
    },
    "intent": {
      "type": "object"
    },
    "scope": {
      "type": "object",
      "required": [
        "include",
        "exclude"
      ]
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string"
    }
  }
}