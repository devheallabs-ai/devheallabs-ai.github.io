digraph G { graph [rankdir=LR, bgcolor="white", nodesep=.25, ranksep=.5]; node [shape=box, style="rounded,filled", fontname="Arial", fontsize=10, color="#17365D", fillcolor="#EAF2F8"]; edge [color="#53759D", penwidth=1.5]; a [label="Intent"]; b [label="Requirements"]; c [label="Architecture"]; d [label="Task"]; e [label="Implementation"]; f [label="Validation"]; g [label="Evidence"]; h [label="Release"]; i [label="Production Feedback"]; a->b->c->d->e->f->g->h->i->a; adlc [label="ADLC governs agent lifecycle", shape=note, fillcolor="#F3E8FF"]; sdlc [label="AI-SDLC governs software lifecycle", shape=note, fillcolor="#E0F2FE"]; adlc->e [style=dashed]; sdlc->e [style=dashed]; }