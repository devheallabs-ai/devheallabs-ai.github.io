digraph G { graph [rankdir=LR, bgcolor="white"]; node [shape=box, style="rounded,filled", fontname="Arial", fontsize=10, color="#17365D"]; edge [color="#53759D", penwidth=1.4]; agent [label="Agent", fillcolor="#E0F2FE"]; contract [label="Contract", fillcolor="#EDE9FE"]; policy [label="Policy", fillcolor="#FEF3C7"]; auth [label="Authorization", fillcolor="#DCFCE7"]; budget [label="Budget", fillcolor="#FFF7ED"]; firewall [label="Side-Effect Firewall", fillcolor="#FEE2E2"]; tool [label="Tool / Target", fillcolor="#EAF2F8"]; agent->contract->policy->auth->budget->firewall->tool; }