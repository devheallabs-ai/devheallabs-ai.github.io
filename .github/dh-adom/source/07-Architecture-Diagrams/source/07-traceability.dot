digraph G { graph [rankdir=LR, bgcolor="white"]; node [shape=box, style="rounded,filled", fontname="Arial", fontsize=10, color="#17365D", fillcolor="#EAF2F8"]; edge [color="#53759D", penwidth=1.4]; i [label="Intent"]; r [label="Requirement"]; f [label="Feature"]; a [label="Agent"]; t [label="Task"]; c [label="Code"]; x [label="Test"]; ev [label="Evidence", fillcolor="#DCFCE7"]; cert [label="Certification", fillcolor="#EDE9FE"]; rel [label="Release", fillcolor="#FEF3C7"]; prod [label="Production", fillcolor="#FFF7ED"]; i->r->f->a->t->c->x->ev->cert->rel->prod; }