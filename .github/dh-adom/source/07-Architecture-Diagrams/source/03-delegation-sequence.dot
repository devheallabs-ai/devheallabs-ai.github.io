digraph G { graph [rankdir=LR, bgcolor="white", nodesep=.35, ranksep=.65]; node [shape=box, style="rounded,filled", fontname="Arial", fontsize=10, color="#17365D", fillcolor="#EAF2F8"]; edge [color="#53759D", penwidth=1.4]; u [label="User"]; r [label="Root Agent", fillcolor="#17365D", fontcolor="white"]; f [label="Feature Agent", fillcolor="#2F5597", fontcolor="white"]; s [label="Specialist Agent", fillcolor="#0E7490", fontcolor="white"]; v [label="Validation", fillcolor="#E8F5E9"]; e [label="Evidence + Handoff", fillcolor="#FFF7ED"]; u->r [label="1. Request"]; r->f [label="2. Route + Delegate"]; f->s [label="3. Bounded task"]; s->v [label="4. Execute"]; v->e [label="5. Results"]; e->f [label="6. Specialist handoff"]; f->r [label="7. Feature handoff"]; r->u [label="8. Final outcome"]; }